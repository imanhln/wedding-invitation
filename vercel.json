{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": { "maxDuration": 20 }
  },
  "images": {
    "sizes": [128, 320, 480, 640, 960, 1280, 1600],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2678400,
    "dangerouslyAllowSVG": false,
    "localPatterns": [
      { "pathname": "^/figma/.*$", "search": "" },
      { "pathname": "^/uploads/.*$", "search": "" }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "REPLACE_WITH_R2_PUBLIC_HOST",
        "pathname": "^/.*$"
      }
    ]
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/$", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "^/(?!_vercel/).*$", "dest": "/api" }
  ]
}
