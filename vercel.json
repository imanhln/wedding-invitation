{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": { "maxDuration": 20 }
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/$", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/api" }
  ]
}
