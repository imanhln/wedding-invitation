# ---- Chạy máy cá nhân ----
PORT=4000
ADMIN_PASSWORD=Password@123

# ---- Biến môi trường trên Vercel ----
# SITE_ID          : tách dữ liệu 2 site. Nhà trai đặt nha-trai, nhà gái đặt nha-gai.
# ADMIN_PASSWORD   : mật khẩu vào /admin — mỗi site đặt một mật khẩu khác nhau.
# DATA_SECRET      : chuỗi ngẫu nhiên, dùng để giấu đường dẫn file dữ liệu.
#                    ĐẶT MỘT LẦN RỒI THÔI — đổi là site không đọc được dữ liệu cũ.
# SESSION_SECRET   : chuỗi ngẫu nhiên để ký token đăng nhập admin.
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET :
#   thông tin bucket Cloudflare R2 (Dashboard > R2 > tên bucket > Manage API tokens).
# R2_PUBLIC_HOST   : domain public để đọc file (Public Development URL dạng
#                     pub-xxxx.r2.dev, hoặc custom domain đã gắn cho bucket).
#                     Không kèm https:// hay dấu / cuối.
